[Unit]
Description=NestBot Telegram archive service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=nestbot
Group=nestbot
WorkingDirectory=/var/lib/nestbot
EnvironmentFile=/etc/nestbot/secrets.env
ExecStart=/usr/local/bin/nestbot --config /etc/nestbot/nestbot.toml serve
Restart=on-failure
RestartSec=10
TimeoutStopSec=25
StateDirectory=nestbot
StateDirectoryMode=0700
CacheDirectory=nestbot
CacheDirectoryMode=0700
RuntimeDirectory=nestbot
RuntimeDirectoryMode=0700
UMask=0077
CPUQuota=50%
MemoryHigh=384M
MemoryMax=512M
TasksMax=32
LimitNOFILE=512
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/nestbot /var/cache/nestbot /run/nestbot
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nestbot

[Install]
WantedBy=multi-user.target
